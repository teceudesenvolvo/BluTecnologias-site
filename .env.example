# Chave pública fornecida pelo Portal de Compras Públicas para a API oficial.
VITE_PORTAL_COMPRAS_PUBLICAS_PUBLIC_KEY=

# Chave pública do Pagar.me usada apenas para tokenização transparente do cartão no checkout nativo.
VITE_PAGARME_PUBLIC_KEY=

# URL base da API da Blu (Firebase Functions / Firebase Hosting).
# Em produção, pode ficar vazio se a aplicação e a API estiverem no mesmo domínio.
VITE_BLU_API_BASE_URL=
