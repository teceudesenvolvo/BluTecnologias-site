{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/compras-gov/:path*",
      "destination": "https://dadosabertos.compras.gov.br/:path*"
    },
    {
      "source": "/api/pncp/domain/:path*",
      "destination": "https://pncp.gov.br/api/pncp/:path*"
    },
    {
      "source": "/api/pncp/file/:path*",
      "destination": "https://pncp.gov.br/pncp-api/:path*"
    },
    {
      "source": "/api/pncp/:path*",
      "destination": "https://pncp.gov.br/api/:path*"
    },
    {
      "source": "/api/tce-ce/:path*",
      "destination": "https://api-dados-abertos.tce.ce.gov.br/sim/:path*"
    },
    {
      "source": "/api/portal-compras-publicas/:path*",
      "destination": "https://apipcp.portaldecompraspublicas.com.br/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}